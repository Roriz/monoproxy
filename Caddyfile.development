app.enrichreader.localhost {
	reverse_proxy 127.0.0.1:5173
}
api.enrichreader.localhost {
	reverse_proxy 127.0.0.1:3000
}
mail.localhost {
	reverse_proxy 127.0.0.1:1080
}

enrichreader.localhost {
	root * ./public/enrichreader.com

	# The old EPUB reader page moved to the story companion page
	@epubReader path /epub-reader /epub-reader/ /epub-reader/*
	redir @epubReader /story-companion/ permanent

	# Enable compression
	encode zstd gzip

	# Cache headers for static assets
	@static {
		file
		path *.ico *.css *.js *.png *.jpg *.jpeg *.svg *.gif *.woff *.woff2 *.webp *.json
		not path /web-guide/* /guia/*
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	@webGuide path /guia /guia/* /autores /autores/ /web-guide/* /_ops/nao-contar
	handle @webGuide {
		reverse_proxy 127.0.0.1:3003 {
			header_up X-Web-Guide-Client-IP {remote_host}
		}
	}
	# Same 404 handling as production: no /index.html fallback, so unknown URLs get a real 404.
	handle {
		try_files {path} {path}/
		file_server
	}

	# Static-site 404s get the generated /404.html with the 404 status kept. Responses from the
	# web-guide service above are passed through as the service sent them.
	handle_errors {
		@notFound expression {err.status_code} == 404
		handle @notFound {
			rewrite * /404.html
			file_server
		}
	}
}
