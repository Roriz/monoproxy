app.enrichreader.com {
	root * {$READER_APP_PATH:/apps/reader-app}/build

	# Enable compression
	encode zstd gzip

	# Only the build's hashed files can be kept forever: their names change with their content.
	@immutable {
		file
		path /_app/immutable/*
	}
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Every other file keeps its name across releases (vendored libraries, fonts, icons,
	# release-notes.json), so the browser checks with us before reusing it; unchanged files cost a
	# 304. Kept for a year, a library's files outlived an upgrade and mixed with the new ones.
	@static {
		file
		path *.ico *.css *.js *.mjs *.png *.jpg *.jpeg *.svg *.gif *.woff *.woff2 *.webp *.json *.wasm
		not path /_app/immutable/* /service-worker.js /version.txt
	}
	header @static Cache-Control "public, no-cache"

	# Cache headers for dynamic versioning and service worker updates
	@no-cache {
		path /service-worker.js /version.txt
	}
	header @no-cache Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"

	# A share from Android is the service worker's to answer. Before the app's first launch there is
	# no worker yet and the file can't be kept: open the app, whose file marker says it didn't arrive.
	@shareWithoutWorker {
		method POST
		path /share-target
	}
	redir @shareWithoutWorker /library?open_file=1 303

	try_files {path} {path}/ /index.html

	file_server
}

www.enrichreader.com {
	redir https://enrichreader.com{uri} permanent
}

enrichreader.com {
	root * {$MONOPROXY_ROOT:/apps/monoproxy}/public/enrichreader.com

	# Redirect old download route to app route
	redir /download* /app 302

	# The old EPUB reader page moved to the story companion page
	@epubReader path /epub-reader /epub-reader/ /epub-reader/*
	redir @epubReader /story-companion/ permanent

	# Baseline browser security policy. Kept explicit for the report charts and our own Umami visit counter (stats.enrichreader.com).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://stats.enrichreader.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self' https://api.enrichreader.com https://stats.enrichreader.com"
	}

	# Enable compression
	encode zstd gzip

	# Cache headers for static assets (short cache + revalidation since filenames are not content-hashed)
	@static {
		file
		path *.ico *.css *.js *.png *.jpg *.jpeg *.svg *.gif *.woff *.woff2 *.webp *.json
		not path /web-guide/* /guia/*
	}
	header @static Cache-Control "public, max-age=3600, must-revalidate"

	# HTML pages should always revalidate
	@html {
		file
		path *.html
		not path /guia/* /autores/*
	}
	header @html Cache-Control "no-cache"

	@webGuide path /guia /guia/* /autores /autores/ /web-guide/* /_ops/nao-contar
	handle @webGuide {
		reverse_proxy 127.0.0.1:3003 {
			header_up X-Web-Guide-Client-IP {remote_host}
		}
	}
	# Static Hugo site: a file, or a directory with an index.html (file_server redirects /app to /app/).
	# No /index.html fallback: unknown URLs must return a real 404, not the homepage with a 200
	# (that made every typo, and paths such as /llms.txt before it existed, a soft 404).
	handle {
		try_files {path} {path}/
		file_server
	}

	# Static-site 404s get the generated /404.html with the 404 status kept. Responses from the
	# web-guide service above are passed through as the service sent them.
	handle_errors {
		@notFound expression {err.status_code} == 404
		handle @notFound {
			rewrite * /404.html
			file_server
		}
	}
}

stats.enrichreader.com {
	# Umami (reader-backend/compose.umami.yml). The dashboard is protected by Umami's own login
	# with two-factor authentication: a Caddy password prompt cannot sit in front of it, because
	# Umami sends its own Authorization header after login.
	reverse_proxy 127.0.0.1:3002
}

api.enrichreader.com {
	reverse_proxy 127.0.0.1:3000
}

app.activegenie.ai {
	reverse_proxy 127.0.0.1:3001
}
