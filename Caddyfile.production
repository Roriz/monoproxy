app.enrichreader.com {
	root * ../reader-app/build

	# Enable compression
	encode zstd gzip

	# Cache headers for static assets
	@static {
		file
		path *.ico *.css *.js *.png *.jpg *.jpeg *.svg *.gif *.woff *.woff2 *.webp *.json
		not path /service-worker.js /version.txt
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Cache headers for dynamic versioning and service worker updates
	@no-cache {
		path /service-worker.js /version.txt
	}
	header @no-cache Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"

	try_files {path} {path}/ /index.html

	file_server
}

www.enrichreader.com {
	redir https://enrichreader.com{uri} permanent
}

enrichreader.com {
	root * ./public/enrichreader.com

	# Redirect old download route to app route
	redir /download* /app 302

	# Baseline browser security policy. Kept explicit for the externally hosted
	# fonts, report charts and our own Umami visit counter (stats.enrichreader.com).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://stats.enrichreader.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.enrichreader.com https://stats.enrichreader.com"
	}

	# Enable compression
	encode zstd gzip

	# Cache headers for static assets (short cache + revalidation since filenames are not content-hashed)
	@static {
		file
		path *.ico *.css *.js *.png *.jpg *.jpeg *.svg *.gif *.woff *.woff2 *.webp *.json
	}
	header @static Cache-Control "public, max-age=3600, must-revalidate"

	# HTML pages should always revalidate
	@html {
		file
		path *.html
	}
	header @html Cache-Control "no-cache"

	try_files {path} {path}/ /index.html

	file_server
}

stats.enrichreader.com {
	# Umami (reader-backend/compose.umami.yml). The dashboard is protected by Umami's own login
	# with two-factor authentication: a Caddy password prompt cannot sit in front of it, because
	# Umami sends its own Authorization header after login.
	reverse_proxy 127.0.0.1:3002
}

api.enrichreader.com {
	reverse_proxy 127.0.0.1:3000
}

app.activegenie.ai {
	reverse_proxy 127.0.0.1:3001
}
