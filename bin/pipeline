#!/bin/bash
# ==============================================================================
# EnrichReader Multi-Repository Pipeline Orchestrator
# ==============================================================================
# Thin coordinator CLI that delegates tasks to native scripts in sibling repos:
#   - reader-app:     Volume Parser & Benchmark verification
#   - skin-maker:     NLP & LLM Skin Generation
#   - reader-backend: Catalog DB & ActiveStorage sync
#   - enrichreader-lfs: Shared Data Hub (raws, volumes, skins)
# ==============================================================================

set -e
set -u
set -o pipefail

# Sourcing helper styles from monoproxy
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MONOPROXY_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=bin/helpers/utils.sh
if [ -f "$SCRIPT_DIR/helpers/utils.sh" ]; then
  source "$SCRIPT_DIR/helpers/utils.sh"
  # utils.sh's error() exits only when utils.sh is the entry point, which it
  # never is when sourced: every `error` here fell through and the next step
  # ran anyway ("Raw EPUB not found" went on to invoke the parser). Fatal here.
  error() { echo -e "${RED:-}[ERROR]${NC:-} $1" >&2; exit 1; }
else
  header() { echo -e "\n=== $1 ==="; }
  step() { echo -e "  ➜ $1"; }
  info() { echo -e "[INFO] $1"; }
  success() { echo -e "[SUCCESS] $1"; }
  warn() { echo -e "[WARN] $1"; }
  error() { echo -e "[ERROR] $1" >&2; exit 1; }
fi

# Repository Paths
PROJECTS_ROOT="${PROJECTS_ROOT:-$(cd "$MONOPROXY_DIR/.." && pwd)}"
READER_APP_DIR="${READER_APP_DIR:-$PROJECTS_ROOT/reader-app}"
SKIN_MAKER_DIR="${SKIN_MAKER_DIR:-$PROJECTS_ROOT/skin-maker}"
READER_BACKEND_DIR="${READER_BACKEND_DIR:-$PROJECTS_ROOT/reader-backend}"
LFS_DIR="${ENRICHREADER_LFS_DIR:-$PROJECTS_ROOT/enrichreader-lfs}"

# Ensure sibling directories exist
verify_repositories() {
  local missing=()
  [ ! -d "$READER_APP_DIR" ] && missing+=("reader-app ($READER_APP_DIR)")
  [ ! -d "$SKIN_MAKER_DIR" ] && missing+=("skin-maker ($SKIN_MAKER_DIR)")
  [ ! -d "$READER_BACKEND_DIR" ] && missing+=("reader-backend ($READER_BACKEND_DIR)")
  [ ! -d "$LFS_DIR" ] && missing+=("enrichreader-lfs ($LFS_DIR)")

  if [ ${#missing[@]} -gt 0 ]; then
    error "Missing required repository directories:\n  - $(IFS=$'\n  - '; echo "${missing[*]}")"
  fi
}

usage() {
  cat << EOF
Usage: bin/pipeline <command> [options]

Commands:
  run <rawUuid>         Run the full end-to-end pipeline (parse -> skin -> backend -> benchmark)
  parse <rawUuid> [--force]
                        Parse EPUB raw into Volume JSON (in enrichreader-lfs/volumes);
                        skipped when the volume already matches this raw and parser build
  series <output_name>  Parse a series, then run decision-first stages and export one skin
  generate <volumeUuid> Run decision-first stages and export a skin
  sync [uuid] [file]    Sync skin .ers with reader-backend (or all via db:seed)
  benchmark [rawUuid]   Run reader-app verification

Generation options (run, generate, series):
  --pipeline <route>        generate/run: recognize | resolve | enrich | decision-first (default)
  --phase <route>           series: same routes (default: decision-first)
  --output-name <name>      Default package name (single volume defaults to volumeUuid)
  --package-output [path]   Export to path, or <SKINS_DIR>/<name>.ers without a path
                            decision-first/enrich export by default; other routes do not
  --ner-version <version>   Pinned NLP configuration, required for Recognition
  --decision-provider <p>   local (default) | typesafe (explicit remote provider)
  --decision-model <model>  Approved local model id or path (fields and identity adapters);
                            with typesafe, an explicit pinned remote model id
  --client <provider>       Enrichment provider, e.g. openai, gemini or llama
  --llm-model <model>       Pinned Enrichment model, required for uncached requests
  --theme <theme>           Recognition theme: lotm | reverend_insanity; omit for generic
  --scope <scope>           entities | story | both
  --artifact-root <path>    Frozen stage artifacts (default: artifacts)
  --input-root <path>       Parsed volumes root
  --max-chapters <n>        Bounded Recognition input
  --entity-state-input <p>  Frozen predecessor snapshot for a single volume
  --story-ledger-input <p>  Frozen predecessor story ledger
  --story-start            Explicit empty initial story ledger

Parsing/run options:
  --force                  Re-parse EPUBs (never forwarded to skin-maker)
  --skip-parse             Use already parsed volumes (run/series)
  --skip-skin              Skip generation (run)
  --skip-backend           Skip catalog sync (run)
  --skip-benchmark         Skip benchmark (run)

Legacy --prev-volume, --fresh, --max-attempts and --tier are retired.
Series continuity comes from orchestrate_volumes.VOLUMES_TO_PROCESS.

Examples:
  bin/pipeline generate v-dracula --ner-version <pin> --decision-model <local-model> --client openai --llm-model <pin>
  bin/pipeline series skin-lotm --skip-parse --phase enrich --client openai --llm-model <pin>
  bin/pipeline generate v-dracula --pipeline resolve --decision-model <local-model>

EOF
  exit 0
}

# ------------------------------------------------------------------------------
# Action: Parse (EPUB -> Volume JSON)
# ------------------------------------------------------------------------------
action_parse() {
  local raw_uuid="$1"
  local force="${2:-false}"
  local volume_uuid="v-${raw_uuid#v-}"
  local raw_path="$LFS_DIR/raws/raw-${raw_uuid}.epub"

  step "Parsing raw '$raw_uuid' -> '$volume_uuid' in enrichreader-lfs..."
  if [ ! -f "$raw_path" ]; then
    error "Raw EPUB not found at: $raw_path"
  fi

  # Idempotent: volume.json records the raw's md5 (`checksum`) and the parser
  # build (`parser_version`, from epub-parser/pkg/fingerprint.js). Same raw,
  # same parser, same output - so a series re-run costs nothing here, and a
  # parser rebuild is what makes the parse happen again.
  if [ "$force" != true ] && [ -f "$LFS_DIR/volumes/$volume_uuid/volume.json" ]; then
    local want_checksum want_parser
    want_checksum="$(md5sum "$raw_path" | cut -d' ' -f1)"
    want_parser="$(sed -n "s/.*last_build_fingerprint = '\([0-9a-f]*\)'.*/\1/p" \
      "$READER_APP_DIR/lib/rbook/epub-parser/pkg/fingerprint.js")"
    if python3 - "$LFS_DIR/volumes/$volume_uuid/volume.json" "$want_checksum" "$want_parser" <<'PY'
import json, sys
info = json.load(open(sys.argv[1]))
sys.exit(0 if (info.get("checksum"), info.get("parser_version")) == (sys.argv[2], sys.argv[3]) and sys.argv[3] else 1)
PY
    then
      info "Volume '$volume_uuid' is already parsed from this raw with this parser; skipping (--force to re-parse)."
      return 0
    fi
  fi

  (
    cd "$READER_APP_DIR"
    node lib/rbook/playground/volume_install.worker.js \
      --rawUuid "$raw_uuid" \
      --volumeUuid "$volume_uuid"
  )
  success "Volume parsed and saved to: $LFS_DIR/volumes/$volume_uuid"
}

# ------------------------------------------------------------------------------
# Action: Generate Skin (Volume JSON -> .ers)
# ------------------------------------------------------------------------------
# Keep one interpreter check for both volume and series dispatch.
skin_python() {
  local candidate="$SKIN_MAKER_DIR/.venv/bin/python"
  if [ "$("$candidate" -c 'import sys; sys.stdout.write("py%d" % sys.version_info[0])' 2>/dev/null)" != py3 ]; then
    candidate=python3
  fi
  [ "$("$candidate" -c 'import sys; sys.stdout.write("py%d" % sys.version_info[0])' 2>/dev/null)" = py3 ] || error "No working Python 3 interpreter found."
  echo "$candidate"
}

# Sets generation_args and route in the caller's local scope. Reject retired flags
# here so they cannot silently change the meaning of a decision-first invocation.
generation_option() {
  consumed=1
  case "$1" in
    --pipeline|--phase)
      [ $# -ge 2 ] || error "Missing value for $1"
      case "$2" in
        recognize|resolve|enrich|decision-first) route="$2" ;;
        *) error "Unknown or retired skin-maker route: $2" ;;
      esac
      consumed=2 ;;
    --package-output)
      generation_args+=("$1")
      if [ $# -ge 2 ] && [[ "$2" != --* ]]; then
        generation_args+=("$2"); consumed=2
      fi ;;
    --story-start|--discover-candidates|--pathway-relations) generation_args+=("$1") ;;
    --theme|--client|--output-name|--ner-version|--decision-provider|--decision-model|--llm-model|--scope|--artifact-root|--input-root|--max-chapters|--entity-state-input|--story-ledger-input|--decision-concurrency|--minimum-confidence|--acceptance-policy|--proposal-input)
      [ $# -ge 2 ] && [[ "$2" != --* ]] || error "Missing value for $1"
      generation_args+=("$1" "$2"); consumed=2 ;;
    *) error "Unknown or retired generation option: $1" ;;
  esac
}

export_by_default() {
  case "$route" in
    decision-first|enrich)
      local arg
      for arg in "${generation_args[@]}"; do
        [ "$arg" = --package-output ] && return 0
      done
      generation_args+=(--package-output) ;;
  esac
}

action_generate_cli() {
  local volume_uuid="$1"; shift
  local route=decision-first consumed
  local generation_args=()
  while [[ $# -gt 0 ]]; do
    generation_option "$@"; shift "$consumed"
  done
  export_by_default
  local python_bin
  python_bin="$(skin_python)"
  (
    cd "$SKIN_MAKER_DIR"
    "$python_bin" process_volume.py "$route" --volume "$volume_uuid" "${generation_args[@]}"
  )
  success "Skin stage complete for $volume_uuid. Packages use <SKINS_DIR>/<name>.ers."
}

action_series() {
  local series="$1"; shift
  local route=decision-first consumed
  local force=false skip_parse=false
  local generation_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=true; shift ;;
      --skip-parse) skip_parse=true; shift ;;
      *) generation_option "$@"; shift "$consumed" ;;
    esac
  done
  export_by_default
  local python_bin volumes
  python_bin="$(skin_python)"
  volumes="$(cd "$SKIN_MAKER_DIR" && "$python_bin" - "$series" <<'PYTHON'
import sys
from orchestrate_volumes import VOLUMES_TO_PROCESS
print("\n".join(t["volume"] for t in VOLUMES_TO_PROCESS if t.get("output_name") == sys.argv[1]))
PYTHON
)"
  [ -n "$volumes" ] || error "No volumes with output_name '$series' in skin-maker/orchestrate_volumes.py"
  if [ "$skip_parse" != true ]; then
    local v
    for v in $volumes; do action_parse "${v#v-}" "$force"; done
  fi
  (
    cd "$SKIN_MAKER_DIR"
    "$python_bin" orchestrate_volumes.py --series "$series" --phase "$route" "${generation_args[@]}"
  )
  success "Series $series: $route complete."
}

# ------------------------------------------------------------------------------
# Action: Sync Backend (Catalog & ActiveStorage)
# ------------------------------------------------------------------------------
action_sync() {
  local uuid="${1:-}"
  local file_path="${2:-}"

  step "Syncing skins with reader-backend..."
  (
    cd "$READER_BACKEND_DIR"
    if [ -n "$uuid" ] && [ -n "$file_path" ]; then
      docker compose exec -T api bin/rake "skins:update[$uuid,$file_path]"
    else
      docker compose exec -T api bin/rails db:seed
    fi
  )
  success "Backend skins catalog synced!"
}

# ------------------------------------------------------------------------------
# Action: Benchmark (Reader Verification)
# ------------------------------------------------------------------------------
action_benchmark() {
  local only="${1:-}"

  step "Running verification benchmark in reader-app..."
  (
    cd "$READER_APP_DIR"
    if [ -n "$only" ]; then
      node lib/rbook/playground/run_benchmark.js --only "$only"
    else
      node lib/rbook/playground/run_benchmark.js
    fi
  )
  success "Benchmark completed!"
}

# ------------------------------------------------------------------------------
# Action: Full End-to-End Run
# ------------------------------------------------------------------------------
action_run() {
  local raw_uuid="$1"
  shift

  local generation_args=() route=decision-first consumed
  local force=false
  local skip_parse=false
  local skip_skin=false
  local skip_backend=false
  local skip_benchmark=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=true; shift ;;
      --skip-parse) skip_parse=true; shift ;;
      --skip-skin) skip_skin=true; shift ;;
      --skip-backend) skip_backend=true; shift ;;
      --skip-benchmark) skip_benchmark=true; shift ;;
      *) generation_option "$@"; shift "$consumed" ;;
    esac
  done

  local volume_uuid="v-${raw_uuid#v-}"

  header "Starting Pipeline Run for: $raw_uuid"
  info "Raw UUID:      $raw_uuid"
  info "Volume UUID:   $volume_uuid"

  # Step 1: Parse
  if [ "$skip_parse" = true ]; then
    info "Skipping parser step (--skip-parse)."
  else
    header "Step 1: Volume Parsing (reader-app)"
    action_parse "$raw_uuid" "$force"
  fi

  # Step 2: Skin Generation
  if [ "$skip_skin" = true ]; then
    info "Skipping skin generation step (--skip-skin)."
  else
    header "Step 2: Skin Generation (skin-maker)"
    action_generate_cli "$volume_uuid" --pipeline "$route" "${generation_args[@]}"
  fi

  # Step 3: Backend Sync
  if [ "$skip_backend" = true ]; then
    info "Skipping backend sync step (--skip-backend)."
  else
    header "Step 3: Backend Sync (reader-backend)"
    action_sync
  fi

  # Step 4: Verification Benchmark
  if [ "$skip_benchmark" = true ]; then
    info "Skipping benchmark step (--skip-benchmark)."
  else
    header "Step 4: Reader Verification Benchmark (reader-app)"
    action_benchmark "$raw_uuid"
  fi

  header "Pipeline Execution Completed Successfully!"
}

# ------------------------------------------------------------------------------
# Main Dispatcher
# ------------------------------------------------------------------------------
main() {
  if [[ "${1:-}" = --help || "${1:-}" = -h || "${1:-}" = help ]]; then usage; fi
  verify_repositories

  if [ $# -lt 1 ]; then
    usage
  fi

  local command="$1"
  shift

  case "$command" in
    run)
      if [ $# -lt 1 ]; then error "Missing rawUuid for 'run' command."; fi
      action_run "$@"
      ;;
    parse)
      if [ $# -lt 1 ]; then error "Missing rawUuid for 'parse' command."; fi
      action_parse "$1" "$([ "${2:-}" = "--force" ] && echo true || echo false)"
      ;;
    series)
      if [ $# -lt 1 ]; then error "Missing series name for 'series' command (an output_name, e.g. skin-lotm)."; fi
      action_series "$@"
      ;;
    generate)
      if [ $# -lt 1 ]; then error "Missing volumeUuid for 'generate' command."; fi
      action_generate_cli "$@"
      ;;
    sync)
      action_sync "$@"
      ;;
    benchmark)
      action_benchmark "${1:-}"
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      error "Unknown command: $command. Run 'bin/pipeline --help' for usage."
      ;;
  esac
}

main "$@"
