#!/bin/bash
# ==============================================================================
# EnrichReader Multi-Repository Pipeline Orchestrator
# ==============================================================================
# Thin coordinator CLI that delegates tasks to native scripts in sibling repos:
#   - reader-app:     Volume Parser & Benchmark verification
#   - skin-maker:     NLP & LLM Skin Generation
#   - reader-backend: Catalog DB & ActiveStorage sync
#   - enrichreader-lfs: Shared Data Hub (raws, volumes, skins)
# ==============================================================================

set -e
set -u
set -o pipefail

# Sourcing helper styles from monoproxy
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MONOPROXY_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=bin/helpers/utils.sh
if [ -f "$SCRIPT_DIR/helpers/utils.sh" ]; then
  source "$SCRIPT_DIR/helpers/utils.sh"
  # utils.sh's error() exits only when utils.sh is the entry point, which it
  # never is when sourced: every `error` here fell through and the next step
  # ran anyway ("Raw EPUB not found" went on to invoke the parser). Fatal here.
  error() { echo -e "${RED:-}[ERROR]${NC:-} $1" >&2; exit 1; }
else
  header() { echo -e "\n=== $1 ==="; }
  step() { echo -e "  ➜ $1"; }
  info() { echo -e "[INFO] $1"; }
  success() { echo -e "[SUCCESS] $1"; }
  warn() { echo -e "[WARN] $1"; }
  error() { echo -e "[ERROR] $1" >&2; exit 1; }
fi

# Repository Paths
PROJECTS_ROOT="${PROJECTS_ROOT:-$(cd "$MONOPROXY_DIR/.." && pwd)}"
READER_APP_DIR="${READER_APP_DIR:-$PROJECTS_ROOT/reader-app}"
SKIN_MAKER_DIR="${SKIN_MAKER_DIR:-$PROJECTS_ROOT/skin-maker}"
READER_BACKEND_DIR="${READER_BACKEND_DIR:-$PROJECTS_ROOT/reader-backend}"
LFS_DIR="${ENRICHREADER_LFS_DIR:-$PROJECTS_ROOT/enrichreader-lfs}"

# Ensure sibling directories exist
verify_repositories() {
  local missing=()
  [ ! -d "$READER_APP_DIR" ] && missing+=("reader-app ($READER_APP_DIR)")
  [ ! -d "$SKIN_MAKER_DIR" ] && missing+=("skin-maker ($SKIN_MAKER_DIR)")
  [ ! -d "$READER_BACKEND_DIR" ] && missing+=("reader-backend ($READER_BACKEND_DIR)")
  [ ! -d "$LFS_DIR" ] && missing+=("enrichreader-lfs ($LFS_DIR)")

  if [ ${#missing[@]} -gt 0 ]; then
    error "Missing required repository directories:\n  - $(IFS=$'\n  - '; echo "${missing[*]}")"
  fi
}

usage() {
  cat << EOF
Usage: bin/pipeline <command> [options]

Commands:
  run <rawUuid>         Run the full end-to-end pipeline (parse -> skin -> backend -> benchmark)
  parse <rawUuid> [--force]
                        Parse EPUB raw into Volume JSON (in enrichreader-lfs/volumes);
                        skipped when the volume already matches this raw and parser build
  series <output_name>  Parse every raw of a series, then run skin-maker's passes over it
                        (detect -> extract -> story -> story-finalize), resumable end to end
  generate <volumeUuid> Generate Skin from Volume using skin-maker
  sync [uuid] [file]    Sync skin .ers with reader-backend DB / ActiveStorage (or all via db:seed)
  benchmark [rawUuid]   Run verification benchmark in reader-app

Options for 'run' (--theme, --client, --output-name, --prev-volume and --force
are also accepted by 'generate'):
  --theme <theme>           Series theme (e.g. lotm, dungeon_crawler_carl, mistborn)
  --client <client>         LLM client (default: vertex, options: vertex, gemini, openai, grok, llama, agy)
  --output-name <name>      Consolidated skin output name (e.g. skin-dungeon_crawler_carl)
  --prev-volume <volUuid>   Previous volume namespace for multi-volume series
  --force                   Re-run cached steps instead of skipping completed work
  --tier <high|low>         Extraction depth for build/sample (default: high).
                            high narrates every character; low narrates the main
                            cast only. Both keep facts current. A preview skin
                            comes from --pipeline preview, not from this.
  --pipeline <name>         Which pipeline to run (default: build). One of:
                              build     full volume
                              preview   NLP-only teaser skin, no LLM calls
                              resume    continue from --start-chapter
                              sample    bounded dev slice
                              reverify  re-derive verified facts, free
                              package   build the .ers from an existing cache
                              stats     statistics only
  --skip-parse              Skip EPUB parsing if volume already exists
  --skip-skin               Skip LLM skin generation
  --skip-backend            Skip backend database sync
  --skip-benchmark          Skip reader-app benchmark verification

Options for 'series':
  --client <client>         LLM client (default: vertex)
  --phase <name>            all (default) | detect | extract | story | story-finalize
  --fresh                   Archive each volume's cache before its first command and rebuild
                            from the current parse (skin-maker moves it to cache-backups/)
  --force                   Re-parse every raw and re-run completed steps
  --skip-parse              Do not touch the volumes, run the skin-maker passes only
  --max-attempts <n>        Retries per volume and pass before the series stops (default 5)

Examples:
  bin/pipeline series skin-lotm --fresh              # rebuild from the raws, all passes
  bin/pipeline series skin-ri --phase story          # resume the story pass only
  bin/pipeline run dungeon_crawler_carl_1 --theme dungeon_crawler_carl --client vertex
  bin/pipeline parse lotm-1
  bin/pipeline generate v-lotm-1 --theme lotm --client gemini
  bin/pipeline generate v-lotm-1 --pipeline preview      # every series, free
  bin/pipeline generate v-lotm-1 --tier low             # a lead series
  bin/pipeline generate v-lotm-1 --theme lotm --client gemini   # on request
  bin/pipeline sync
  bin/pipeline benchmark mistborn-1.1
EOF
  exit 1
}

# ------------------------------------------------------------------------------
# Action: Parse (EPUB -> Volume JSON)
# ------------------------------------------------------------------------------
action_parse() {
  local raw_uuid="$1"
  local force="${2:-false}"
  local volume_uuid="v-${raw_uuid#v-}"
  local raw_path="$LFS_DIR/raws/raw-${raw_uuid}.epub"

  step "Parsing raw '$raw_uuid' -> '$volume_uuid' in enrichreader-lfs..."
  if [ ! -f "$raw_path" ]; then
    error "Raw EPUB not found at: $raw_path"
  fi

  # Idempotent: volume.json records the raw's md5 (`checksum`) and the parser
  # build (`parser_version`, from epub-parser/pkg/fingerprint.js). Same raw,
  # same parser, same output - so a series re-run costs nothing here, and a
  # parser rebuild is what makes the parse happen again.
  if [ "$force" != true ] && [ -f "$LFS_DIR/volumes/$volume_uuid/volume.json" ]; then
    local want_checksum want_parser
    want_checksum="$(md5sum "$raw_path" | cut -d' ' -f1)"
    want_parser="$(sed -n "s/.*last_build_fingerprint = '\([0-9a-f]*\)'.*/\1/p" \
      "$READER_APP_DIR/lib/rbook/epub-parser/pkg/fingerprint.js")"
    if python3 - "$LFS_DIR/volumes/$volume_uuid/volume.json" "$want_checksum" "$want_parser" <<'PY'
import json, sys
info = json.load(open(sys.argv[1]))
sys.exit(0 if (info.get("checksum"), info.get("parser_version")) == (sys.argv[2], sys.argv[3]) and sys.argv[3] else 1)
PY
    then
      info "Volume '$volume_uuid' is already parsed from this raw with this parser; skipping (--force to re-parse)."
      return 0
    fi
  fi

  (
    cd "$READER_APP_DIR"
    node lib/rbook/playground/volume_install.worker.js \
      --rawUuid "$raw_uuid" \
      --volumeUuid "$volume_uuid"
  )
  success "Volume parsed and saved to: $LFS_DIR/volumes/$volume_uuid"
}

# ------------------------------------------------------------------------------
# Action: Generate Skin (Volume JSON -> .ers)
# ------------------------------------------------------------------------------
action_generate() {
  local volume_uuid="$1"
  local theme="${2:-}"
  local client="${3:-vertex}"
  local output_name="${4:-}"
  local prev_volume="${5:-}"
  local force="${6:-false}"
  local pipeline="${7:-build}"
  local tier="${8:-}"

  # Make the interpreter prove it is Python, rather than testing for a file.
  # A 0-byte .venv/bin/python passes -f and, being executable with no shebang,
  # is handed to sh: it ignores its arguments, does nothing and exits 0. The
  # whole pipeline then reports [SUCCESS] having generated nothing. Checking the
  # exit status alone is not enough for the same reason - only the output is.
  local python_bin="$SKIN_MAKER_DIR/.venv/bin/python"
  if [ "$("$python_bin" -c 'import sys; sys.stdout.write("py%d" % sys.version_info[0])' 2>/dev/null)" != "py3" ]; then
    python_bin="python3"
  fi
  if [ "$("$python_bin" -c 'import sys; sys.stdout.write("py%d" % sys.version_info[0])' 2>/dev/null)" != "py3" ]; then
    error "No working Python 3 interpreter found (tried $SKIN_MAKER_DIR/.venv/bin/python and python3)."
  fi

  step "Running skin-maker '$pipeline' pipeline for volume '$volume_uuid' (client: ${client:-none})..."
  
  # The pipeline is a positional: what to run is a name now, not a flag combination.
  # `process_volume.py --help` lists them.
  local cmd=("$python_bin" "process_volume.py" "$pipeline" "--volume" "$volume_uuid")
  [ -n "$client" ] && cmd+=("--client" "$client")
  [ -n "$theme" ] && cmd+=("--theme" "$theme")
  [ -n "$output_name" ] && cmd+=("--output-name" "$output_name")
  [ -n "$prev_volume" ] && cmd+=("--prev-volume" "$prev_volume")
  [ "$force" = true ] && cmd+=("--force")

  (
    cd "$SKIN_MAKER_DIR"
    # Exported inside the subshell so it reaches skin-maker's config, which reads
    # it at import, without leaking into the rest of this run.
    [ -n "$tier" ] && export SKIN_TIER="$tier"
    "${cmd[@]}"
  )
  success "Skin generated and saved to: $LFS_DIR/skins/"
}

# Parses the documented flag form of `generate`. The dispatcher used to pass
# "$@" straight through to action_generate's positional parameters, so the
# documented invocation
#   bin/pipeline generate v-lotm-1 --theme lotm --client gemini
# silently ran with theme="--theme" and client="lotm".
action_generate_cli() {
  local volume_uuid="$1"; shift

  local theme=""
  local client="vertex"
  local output_name=""
  local prev_volume=""
  local force=false
  local pipeline="build"
  local tier=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --theme) theme="$2"; shift 2 ;;
      --client) client="$2"; shift 2 ;;
      --output-name) output_name="$2"; shift 2 ;;
      --prev-volume) prev_volume="$2"; shift 2 ;;
      --pipeline) pipeline="$2"; shift 2 ;;
      --tier) tier="$2"; shift 2 ;;
      --force) force=true; shift ;;
      *) error "Unknown option for 'generate': $1" ;;
    esac
  done

  # Pipelines with no LLM steps take no client; passing vertex by default would
  # make process_volume reject them.
  case "$pipeline" in
    preview|reverify|stats) client="" ;;
  esac

  action_generate "$volume_uuid" "$theme" "$client" "$output_name" "$prev_volume" "$force" "$pipeline" "$tier"
}

# ------------------------------------------------------------------------------
# Action: Series (parse every raw of a series, then skin-maker's pass runner)
# ------------------------------------------------------------------------------
# The volume list, chain order and theme live in skin-maker's
# orchestrate_volumes.py; this only adds the parse step that lives in
# reader-app and forwards the rest. Re-runnable end to end: parse skips an
# up-to-date volume, and each skin-maker pass resumes from its own markers.
action_series() {
  local series="$1"; shift
  local client="vertex"
  local phase="all"
  local force=false
  local fresh=false
  local skip_parse=false
  local extra=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --client) client="$2"; shift 2 ;;
      --phase) phase="$2"; shift 2 ;;
      --force) force=true; shift ;;
      --fresh) fresh=true; shift ;;
      --skip-parse) skip_parse=true; shift ;;
      --max-attempts) extra+=("--max-attempts" "$2"); shift 2 ;;
      *) error "Unknown option for 'series': $1" ;;
    esac
  done

  local python_bin="$SKIN_MAKER_DIR/.venv/bin/python"
  [ -x "$python_bin" ] || python_bin="python3"

  local volumes
  volumes="$(cd "$SKIN_MAKER_DIR" && "$python_bin" - "$series" <<'PY'
import sys
from orchestrate_volumes import VOLUMES_TO_PROCESS
print("\n".join(t["volume"] for t in VOLUMES_TO_PROCESS if t.get("output_name") == sys.argv[1]))
PY
)"
  [ -n "$volumes" ] || error "No volumes with output_name '$series' in skin-maker/orchestrate_volumes.py"

  header "Series $series: $(echo "$volumes" | wc -l) volume(s)"
  if [ "$skip_parse" = true ]; then
    info "Skipping parse (--skip-parse)."
  else
    header "Step 1: Volume parsing (reader-app)"
    local v
    for v in $volumes; do
      action_parse "${v#v-}" "$force"
    done
  fi

  # The detect pass is the one NER step, and it talks to skin-maker's nlp-api
  # container. Fail here, before anything else is archived or spent, rather
  # than five retries into the first volume.
  if [ "$phase" = all ] || [ "$phase" = detect ]; then
    local ner_url="${NER_API_URL:-http://127.0.0.1:8000}"
    if ! curl -s -m 5 -o /dev/null -X POST -H 'Content-Type: application/json' \
        -d '{"texts":[],"ignore_labels":[]}' "$ner_url/extract"; then
      error "NER service not reachable at $ner_url. Start it in another terminal first:\n  cd $SKIN_MAKER_DIR && bin/nlp_api"
    fi
  fi

  header "Step 2: skin-maker passes ($phase)"
  (
    cd "$SKIN_MAKER_DIR"
    local cmd=("$python_bin" orchestrate_volumes.py --series "$series" --client "$client" --phase "$phase" "${extra[@]}")
    [ "$force" = true ] && cmd+=("--force")
    [ "$fresh" = true ] && cmd+=("--fresh")
    "${cmd[@]}"
  )
  success "Series $series: passes complete."
}

# ------------------------------------------------------------------------------
# Action: Sync Backend (Catalog & ActiveStorage)
# ------------------------------------------------------------------------------
action_sync() {
  local uuid="${1:-}"
  local file_path="${2:-}"

  step "Syncing skins with reader-backend..."
  (
    cd "$READER_BACKEND_DIR"
    if [ -n "$uuid" ] && [ -n "$file_path" ]; then
      docker compose exec -T api bin/rake "skins:update[$uuid,$file_path]"
    else
      docker compose exec -T api bin/rails db:seed
    fi
  )
  success "Backend skins catalog synced!"
}

# ------------------------------------------------------------------------------
# Action: Benchmark (Reader Verification)
# ------------------------------------------------------------------------------
action_benchmark() {
  local only="${1:-}"

  step "Running verification benchmark in reader-app..."
  (
    cd "$READER_APP_DIR"
    if [ -n "$only" ]; then
      node lib/rbook/playground/run_benchmark.js --only "$only"
    else
      node lib/rbook/playground/run_benchmark.js
    fi
  )
  success "Benchmark completed!"
}

# ------------------------------------------------------------------------------
# Action: Full End-to-End Run
# ------------------------------------------------------------------------------
action_run() {
  local raw_uuid="$1"
  shift

  local theme=""
  local client="vertex"
  local output_name=""
  local prev_volume=""
  local force=false
  local skip_parse=false
  local skip_skin=false
  local skip_backend=false
  local skip_benchmark=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --theme) theme="$2"; shift 2 ;;
      --client) client="$2"; shift 2 ;;
      --output-name) output_name="$2"; shift 2 ;;
      --prev-volume) prev_volume="$2"; shift 2 ;;
      --force) force=true; shift ;;
      --skip-parse) skip_parse=true; shift ;;
      --skip-skin) skip_skin=true; shift ;;
      --skip-backend) skip_backend=true; shift ;;
      --skip-benchmark) skip_benchmark=true; shift ;;
      *) error "Unknown option: $1" ;;
    esac
  done

  local volume_uuid="v-${raw_uuid#v-}"

  header "Starting Pipeline Run for: $raw_uuid"
  info "Raw UUID:      $raw_uuid"
  info "Volume UUID:   $volume_uuid"
  info "Theme:         ${theme:-<auto/none>}"
  info "Client:        $client"
  info "Output Name:   ${output_name:-<default>}"

  # Step 1: Parse
  if [ "$skip_parse" = true ]; then
    info "Skipping parser step (--skip-parse)."
  else
    header "Step 1: Volume Parsing (reader-app)"
    action_parse "$raw_uuid"
  fi

  # Step 2: Skin Generation
  if [ "$skip_skin" = true ]; then
    info "Skipping skin generation step (--skip-skin)."
  else
    header "Step 2: Skin Generation (skin-maker)"
    action_generate "$volume_uuid" "$theme" "$client" "$output_name" "$prev_volume" "$force"
  fi

  # Step 3: Backend Sync
  if [ "$skip_backend" = true ]; then
    info "Skipping backend sync step (--skip-backend)."
  else
    header "Step 3: Backend Sync (reader-backend)"
    action_sync
  fi

  # Step 4: Verification Benchmark
  if [ "$skip_benchmark" = true ]; then
    info "Skipping benchmark step (--skip-benchmark)."
  else
    header "Step 4: Reader Verification Benchmark (reader-app)"
    action_benchmark "$raw_uuid"
  fi

  header "Pipeline Execution Completed Successfully!"
}

# ------------------------------------------------------------------------------
# Main Dispatcher
# ------------------------------------------------------------------------------
main() {
  verify_repositories

  if [ $# -lt 1 ]; then
    usage
  fi

  local command="$1"
  shift

  case "$command" in
    run)
      if [ $# -lt 1 ]; then error "Missing rawUuid for 'run' command."; fi
      action_run "$@"
      ;;
    parse)
      if [ $# -lt 1 ]; then error "Missing rawUuid for 'parse' command."; fi
      action_parse "$1" "$([ "${2:-}" = "--force" ] && echo true || echo false)"
      ;;
    series)
      if [ $# -lt 1 ]; then error "Missing series name for 'series' command (an output_name, e.g. skin-lotm)."; fi
      action_series "$@"
      ;;
    generate)
      if [ $# -lt 1 ]; then error "Missing volumeUuid for 'generate' command."; fi
      action_generate_cli "$@"
      ;;
    sync)
      action_sync "$@"
      ;;
    benchmark)
      action_benchmark "${1:-}"
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      error "Unknown command: $command. Run 'bin/pipeline --help' for usage."
      ;;
  esac
}

main "$@"
