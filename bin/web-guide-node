#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
if command -v node >/dev/null 2>&1 && [ "${WEB_GUIDE_DOCKER_NODE:-0}" != 1 ]; then
  exec node "$@"
fi
guide_mounts=()
guide_environment=(--env WEB_GUIDE_WHATSAPP --env INDEXNOW_KEY)
if [ "${1:-}" = scripts/web-guide/indexnow.mjs ] && [ "${2:-}" != key ]; then
  guide_state=${WEB_GUIDE_INDEXNOW_STATE:-$HOME/.local/state/enrichreader/indexnow.json}
  mkdir -p "$(dirname "$guide_state")"
  guide_mounts=(-v "$(dirname "$guide_state"):/guide-state")
  guide_environment+=(--env "WEB_GUIDE_INDEXNOW_STATE=/guide-state/$(basename "$guide_state")")
fi
exec docker run --rm --user "$(id -u):$(id -g)" --cap-drop ALL \
  --security-opt no-new-privileges:true -v "$PWD:/workspace" -w /workspace \
  "${guide_mounts[@]}" "${guide_environment[@]}" node:24-alpine node "$@"
